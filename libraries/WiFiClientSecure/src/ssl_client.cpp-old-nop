#include "ssl_client.h"

#include "lwip/err.h"
#include "lwip/sockets.h"
#include "lwip/sys.h"
#include "lwip/netdb.h"
#include "lwip/dns.h"

#include "mbedtls/platform.h"
#include "mbedtls/net_sockets.h"
#include "mbedtls/debug.h"
#include "mbedtls/ssl.h"
#include "mbedtls/entropy.h"
#include "mbedtls/ctr_drbg.h"
#include "mbedtls/error.h"
#include "mbedtls/certs.h"
#include "mbedtls/esp_debug.h"

#include <string.h>

// ============================================================================
// CORRECTION POUR ESP8266 RTOS SDK 1.1.1
// Les modes PSK ne sont pas activés dans ce SDK. On désactive donc
// complètement le PSK pour éviter les erreurs de compilation.
// ============================================================================
#undef MBEDTLS_KEY_EXCHANGE__SOME__PSK_ENABLED
// ============================================================================


static int _ssl_client_send(void *ctx, const unsigned char *buf, size_t len);
static int _ssl_client_recv(void *ctx, unsigned char *buf, size_t len);
static void _ssl_client_debug(void *ctx, int level, const char *file, int line, const char *str);

static int _ssl_client_send(void *ctx, const unsigned char *buf, size_t len)
{
    int socket = *(int *)ctx;
    int ret;

    ret = send(socket, buf, len, 0);
    if (ret < 0) {
        return MBEDTLS_ERR_NET_SEND_FAILED;
    }
    return ret;
}

static int _ssl_client_recv(void *ctx, unsigned char *buf, size_t len)
{
    int socket = *(int *)ctx;
    int ret;

    ret = recv(socket, buf, len, 0);
    if (ret < 0) {
        return MBEDTLS_ERR_NET_RECV_FAILED;
    }
    if (ret == 0) {
        return MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY;
    }
    return ret;
}

static void _ssl_client_debug(void *ctx, int level, const char *file, int line, const char *str)
{
    if (level < 4) {
        printf("%s:%04d: %s", file, line, str);
    }
}

int start_ssl_client(sslclient_context *ssl_client, const char *host, uint32_t port,
                     int timeout, const char *rootCABuff, const char *cli_cert,
                     const char *cli_key, const char *pskIdent, const char *psKey,
                     bool insecure)
{
    // ========================================================================
    // PSK DÉSACTIVÉ POUR ESP8266 RTOS SDK 1.1.1
    // On marque les paramètres comme lus (void) pour satisfaire le compilateur
    // (-Wunused-but-set-parameter), puis on les neutralise pour empêcher
    // tout appel à mbedtls_ssl_conf_psk().
    // ========================================================================
    (void)pskIdent;
    (void)psKey;
    pskIdent = NULL;
    psKey    = NULL;
    // ========================================================================

    int ret;
    int32_t handshake_timeout = 120000;
    if (timeout > 0) {
        handshake_timeout = timeout;
    }

    // Noms de champs conformes à sslclient_context de votre SDK :
    //   - entropy_ctx  (et non 'entropy')
    //   - drbg_ctx     (et non 'ctr_drbg')
    mbedtls_entropy_context *entropy_ctx = &ssl_client->entropy_ctx;
    mbedtls_ctr_drbg_context *drbg_ctx   = &ssl_client->drbg_ctx;
    mbedtls_x509_crt *ca_cert            = &ssl_client->ca_cert;
    mbedtls_x509_crt *client_cert        = &ssl_client->client_cert;
    mbedtls_pk_context *client_key       = &ssl_client->client_key;
    mbedtls_ssl_context *ssl             = &ssl_client->ssl_ctx;
    mbedtls_ssl_config *conf             = &ssl_client->ssl_conf;

    mbedtls_platform_set_calloc_free(calloc, free);

    mbedtls_entropy_init(entropy_ctx);
    mbedtls_ctr_drbg_init(drbg_ctx);
    mbedtls_x509_crt_init(ca_cert);
    mbedtls_x509_crt_init(client_cert);
    mbedtls_pk_init(client_key);
    mbedtls_ssl_init(ssl);
    mbedtls_ssl_config_init(conf);

    ret = mbedtls_ctr_drbg_seed(drbg_ctx, mbedtls_entropy_func, entropy_ctx,
                                (const unsigned char *)"esp8266", 7);
    if (ret != 0) {
        printf("mbedtls_ctr_drbg_seed returned -0x%x\n", -ret);
        return -1;
    }

    // ------------------ Configuration du certificat CA ------------------
    if (rootCABuff != NULL) {
        ret = mbedtls_x509_crt_parse(ca_cert, (const unsigned char *)rootCABuff,
                                     strlen(rootCABuff) + 1);
        if (ret < 0) {
            printf("mbedtls_x509_crt_parse CA failed -0x%x\n", -ret);
            return -1;
        }
        if (!insecure) {
            mbedtls_ssl_conf_authmode(conf, MBEDTLS_SSL_VERIFY_REQUIRED);
        } else {
            mbedtls_ssl_conf_authmode(conf, MBEDTLS_SSL_VERIFY_NONE);
        }
        mbedtls_ssl_conf_ca_chain(conf, ca_cert, NULL);
    } else if (!insecure) {
        printf("No CA cert and not insecure mode\n");
        return -1;
    } else {
        mbedtls_ssl_conf_authmode(conf, MBEDTLS_SSL_VERIFY_NONE);
    }

    // ------------------ Configuration du certificat client (optionnel) ------------------
    if (cli_cert != NULL && cli_key != NULL) {
        ret = mbedtls_x509_crt_parse(client_cert, (const unsigned char *)cli_cert,
                                     strlen(cli_cert) + 1);
        if (ret < 0) {
            printf("mbedtls_x509_crt_parse client_cert failed -0x%x\n", -ret);
            return -1;
        }

        ret = mbedtls_pk_parse_key(client_key, (const unsigned char *)cli_key,
                                   strlen(cli_key) + 1, NULL, 0);
        if (ret < 0) {
            printf("mbedtls_pk_parse_key client_key failed -0x%x\n", -ret);
            return -1;
        }

        ret = mbedtls_ssl_conf_own_cert(conf, client_cert, client_key);
        if (ret < 0) {
            printf("mbedtls_ssl_conf_own_cert failed -0x%x\n", -ret);
            return -1;
        }
    }

    // ------------------ Paramètres de configuration SSL ------------------
    ret = mbedtls_ssl_config_defaults(conf, MBEDTLS_SSL_IS_CLIENT,
                                      MBEDTLS_SSL_TRANSPORT_STREAM,
                                      MBEDTLS_SSL_PRESET_DEFAULT);
    if (ret != 0) {
        printf("mbedtls_ssl_config_defaults returned -0x%x\n", -ret);
        return -1;
    }

    mbedtls_ssl_conf_rng(conf, mbedtls_ctr_drbg_random, drbg_ctx);
    mbedtls_ssl_conf_dbg(conf, _ssl_client_debug, stdout);

    ret = mbedtls_ssl_setup(ssl, conf);
    if (ret != 0) {
        printf("mbedtls_ssl_setup returned -0x%x\n", -ret);
        return -1;
    }

    ret = mbedtls_ssl_set_hostname(ssl, host);
    if (ret != 0) {
        printf("mbedtls_ssl_set_hostname returned -0x%x\n", -ret);
        return -1;
    }

    mbedtls_ssl_set_bio(ssl, &ssl_client->socket, _ssl_client_send,
                        _ssl_client_recv, NULL);

    // ------------------ Handshake ------------------
    uint32_t handshake_start = xTaskGetTickCount() * portTICK_PERIOD_MS;
    while ((ret = mbedtls_ssl_handshake(ssl)) != 0) {
        if (ret != MBEDTLS_ERR_SSL_WANT_READ && ret != MBEDTLS_ERR_SSL_WANT_WRITE) {
            printf("mbedtls_ssl_handshake returned -0x%x\n", -ret);
            return -1;
        }
        if ((xTaskGetTickCount() * portTICK_PERIOD_MS - handshake_start) > handshake_timeout) {
            printf("Handshake timeout\n");
            return -1;
        }
        vTaskDelay(10 / portTICK_PERIOD_MS);
    }

    // ------------------ Vérification du certificat ------------------
    if (!insecure) {
        uint32_t flags = mbedtls_ssl_get_verify_result(ssl);
        if (flags != 0) {
            char x509_cert[6144];
            mbedtls_x509_crt_verify_info(x509_cert, sizeof(x509_cert), "", flags);
            printf("Certificate verification failed: %s\n", x509_cert);
            return -1;
        }
    }

    printf("SSL connected to %s:%d\n", host, port);
    return ssl_client->socket;
}

// ============================================================================
// stop_ssl_socket : retour void (conforme à ssl_client.h)
// ============================================================================
void stop_ssl_socket(sslclient_context *ssl_client, const char *rootCABuff,
                     const char *cli_cert, const char *cli_key)
{
    mbedtls_ssl_close_notify(&ssl_client->ssl_ctx);
    mbedtls_ssl_session_reset(&ssl_client->ssl_ctx);
    mbedtls_ssl_config_free(&ssl_client->ssl_conf);
    mbedtls_ctr_drbg_free(&ssl_client->drbg_ctx);
    mbedtls_entropy_free(&ssl_client->entropy_ctx);
    mbedtls_x509_crt_free(&ssl_client->ca_cert);
    mbedtls_x509_crt_free(&ssl_client->client_cert);
    mbedtls_pk_free(&ssl_client->client_key);
}

int send_ssl_data(sslclient_context *ssl_client, const uint8_t *data, uint16_t len)
{
    int ret;
    while ((ret = mbedtls_ssl_write(&ssl_client->ssl_ctx, data, len)) <= 0) {
        if (ret != MBEDTLS_ERR_SSL_WANT_READ && ret != MBEDTLS_ERR_SSL_WANT_WRITE) {
            return -1;
        }
    }
    return ret;
}

int get_ssl_receive(sslclient_context *ssl_client, uint8_t *data, int length)
{
    int ret;
    while ((ret = mbedtls_ssl_read(&ssl_client->ssl_ctx, data, length)) <= 0) {
        if (ret == MBEDTLS_ERR_SSL_WANT_READ || ret == MBEDTLS_ERR_SSL_WANT_WRITE) {
            continue;
        }
        if (ret == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY) {
            return 0;
        }
        return -1;
    }
    return ret;
}

int data_to_read(sslclient_context *ssl_client)
{
    int ret;
    ret = mbedtls_ssl_read(&ssl_client->ssl_ctx, NULL, 0);
    if (ret == MBEDTLS_ERR_SSL_WANT_READ || ret == MBEDTLS_ERR_SSL_WANT_WRITE) {
        return 0;
    }
    return ret;
}

bool verify_ssl_fingerprint(sslclient_context *ssl_client, const char *fp,
                            const char *domain_name)
{
    return true;
}

void ssl_init(sslclient_context *ssl_client)
{
    memset(ssl_client, 0, sizeof(sslclient_context));
    ssl_client->socket = -1;
}